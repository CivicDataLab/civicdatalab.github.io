# Local tier-3 test config. Copy to .env and fill the four blanks.
#   cp env.local.template .env
#
# Everything already filled in is correct for local testing - only the
# values marked <<< FILL >>> need you.

# ---- local URLs (do not change for local testing) --------------------------
PORT=3000
PUBLIC_URL=http://localhost:3000
CMS_ORIGIN=http://localhost:8000
DEBUG=true

# ---- Keycloak (verified live; realm name is case-sensitive) ----------------
KEYCLOAK_ISSUER=https://opub-kc.civicdatalab.in/auth/realms/DataSpace
KEYCLOAK_CLIENT_ID=civicdatalab-cms
KEYCLOAK_REQUIRED_ROLE=cms-editors
OAUTH_SCOPE=openid profile email
KEYCLOAK_ACCEPT_AZP=true

# From Keycloak: client civicdatalab-cms -> Credentials tab -> Secret
KEYCLOAK_CLIENT_SECRET=<<< FILL >>>

# ---- GitHub App ------------------------------------------------------------
# Your own fork, so testing cannot touch production.
GITHUB_REPO=saqibmanan/saqibmanan.github.io

# App settings page, top of the page ("App ID")
GITHUB_APP_ID=<<< FILL >>>

# The number at the end of the URL after installing the app:
#   https://github.com/settings/installations/<THIS NUMBER>
GITHUB_INSTALLATION_ID=<<< FILL >>>

# The downloaded .pem, as ONE line with \n between lines. Generate it with:
#   awk 'BEGIN{ORS="\\n"} {print}' ~/Downloads/your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=<<< FILL >>>

# Optional: identity recorded as committer beside the editor as author.
GITHUB_COMMITTER_NAME=CivicDataLab CMS
GITHUB_COMMITTER_EMAIL=cms@civicdatalab.in
