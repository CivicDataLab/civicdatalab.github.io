# Copy to .env and fill in. Never commit the real file.
# (The repo's .gitignore already excludes .env*)

# ---- server ---------------------------------------------------------------
PORT=3000

# Interface to bind. Loopback by default: this service belongs behind nginx or
# Caddy terminating TLS, and binding 0.0.0.0 would expose the plain-HTTP port on
# the host's public address if a security group ever permitted it. Override only
# when something else provides that boundary, e.g. a container network.
HOST=127.0.0.1
# Verbose per-request logging. Leave false in production.
DEBUG=false

# This service's own public origin. MUST exactly equal `base_url` in Decap's
# config.yml - Decap compares the popup's event.origin against it and silently
# ignores a mismatch, so a wrong value here looks like a login that hangs.
PUBLIC_URL=https://cms-auth.civicdatalab.in

# Origin of the CMS itself.
CMS_ORIGIN=https://civicdatalab.in

# Browser origins permitted to call this proxy, comma-separated.
# Add the localhost entry only if you point a local CMS at this instance.
ALLOWED_ORIGINS=https://civicdatalab.in

# ---- Keycloak -------------------------------------------------------------
# The issuer is the ONLY Keycloak URL normally needed; the authorize, token and
# JWKS endpoints are derived from it. Keycloak here is modern (19+) but runs
# with --http-relative-path=/auth, hence the /auth segment.
KEYCLOAK_ISSUER=https://opub-kc.civicdatalab.in/auth/realms/DataSpace

# PLANNED: opub-kc.civicdatalab.in is to be repurposed as auth.civicdatalab.in.
# When that happens this is a one-line change - and drop /auth too if the
# relative-path setting goes away at the same time:
#   KEYCLOAK_ISSUER=https://auth.civicdatalab.in/realms/DataSpace
#
# The `iss` claim changes with it, so tokens issued by the old hostname stop
# validating. To cut over without logging everyone out, list both during the
# transition and remove the old one afterwards:
# KEYCLOAK_ADDITIONAL_ISSUERS=https://opub-kc.civicdatalab.in/auth/realms/DataSpace

# Defaults to <issuer>/protocol/openid-connect/certs - override only if unusual.
# KEYCLOAK_JWKS_URI=

# The dedicated client created for the CMS.
KEYCLOAK_CLIENT_ID=civicdatalab-cms

# Set this for a CONFIDENTIAL client (recommended - the code exchange happens
# server-side here, so we can hold a secret). Leave unset for a public client,
# in which case PKCE S256 is used automatically.
# KEYCLOAK_CLIENT_SECRET=

# Scopes requested at login. `profile` and `email` are what commit attribution
# depends on; `openid` makes it an OIDC request.
OAUTH_SCOPE=openid profile email

# Derived from the issuer by default - override only if your realm is unusual.
# KEYCLOAK_AUTHORIZE_ENDPOINT=
# KEYCLOAK_TOKEN_ENDPOINT=

# Role or group that grants CMS access. Checked against realm roles, client
# roles, and the `groups` claim - whichever your realm emits.
KEYCLOAK_REQUIRED_ROLE=cms-editors

# Keycloak sets aud="account" and azp=<client> unless an audience mapper is
# configured. Leaving this true accepts azp. Set false once you have added an
# audience mapper (recommended - see README).
KEYCLOAK_ACCEPT_AZP=true

# Leeway for clock skew, seconds.
KEYCLOAK_CLOCK_TOLERANCE=30

# ---- GitHub App -----------------------------------------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_REPO=CivicDataLab/civicdatalab.github.io

# The App's PEM private key. Either paste with \n escapes on one line, or
# point at a file and load it in your process manager. Keep it chmod 600.
GITHUB_APP_PRIVATE_KEY=

# Optional: the identity recorded as *committer*. The editor is always the
# author; this is the machine identity alongside it.
# GITHUB_COMMITTER_NAME=CivicDataLab CMS
# GITHUB_COMMITTER_EMAIL=cms@civicdatalab.in

# Override only for testing against a mock.
# GITHUB_API_ROOT=https://api.github.com
